.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.pytest_cache/

# Los modelos entrenados se regeneran con train_model.py; no se versionan
models/*.joblib

# El dataset SI se versiona: es pequeno (~80 KB) y de dominio publico (CC BY 4.0),
# lo que hace el repositorio autocontenido y reproducible sin pasos manuales.
# Se ignoran los demas ficheros del zip descargado (doc, variante numerica, etc.)
# y se permite unicamente el fichero que el proyecto realmente usa.
data/german-credit-data/*
!data/german-credit-data/german.data
