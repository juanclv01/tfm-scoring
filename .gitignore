.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.pytest_cache/
consideraciones.txt

# Los modelos entrenados se regeneran con los scripts train_model*.py; no se versionan
models/*.joblib

# Datasets: se versiona unicamente el fichero de datos real de cada uno,
# no los ficheros auxiliares que traen los zips de descarga (doc, indices, etc.)
data/german-credit-data/*
!data/german-credit-data/german.data

data/credit-card-default/*
!data/credit-card-default/UCI_Credit_Card.csv

# Home Credit Default (application_train.csv) NO se versiona bajo ningun
# concepto: pesa ~150-160 MB, por encima del limite de 100 MB por fichero
# de GitHub (requeriria Git LFS). Se documenta la descarga en README.md
# en lugar de incluir el fichero.
data/home-credit-default/*
